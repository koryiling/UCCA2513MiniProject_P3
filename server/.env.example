# Copy this file to ".env" (in the same folder) and fill in your own values.
# .env is NOT uploaded to GitHub, so each group member keeps their own password.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=utar_app
DB_PASSWORD=put_your_utar_app_password_here
DB_NAME=utar_admission

# Port for the website and API: open http://localhost:3000
PORT=3000

# --- AI chatbot ----------------------------------------------------------------
# Main AI is tried first, then the backup AI, then the rule-based answers.
# Any provider with an OpenAI-compatible Chat Completions API works.
# Check each provider's website for current free limits and model names.

# Main AI: Groq (free tier, fast; key from https://console.groq.com/keys)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Backup AI: Google Gemini (free tier, key from https://aistudio.google.com/apikey)
AI_BACKUP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=gemini-flash-lite-latest

# Other option - Ollama (free, runs on your own computer, no key needed, https://ollama.com):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen2.5:7b
